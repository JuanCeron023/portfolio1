---
import BrandIcon from "../brand/BrandIcon.astro";
import type { BrandName } from "../brand/registry";

interface Props {
	project: {
		name: string;
		description: string;
		url: string;
		icon: BrandName;
		stars: number;
		repo?: string;
	};
	maxStars: number;
}

const { project } = Astro.props;

// Determine label to show on the right: repo name if available, otherwise a link icon
const repoLabel = project.repo ? project.repo.split("/").pop() : null;
---

<a
	href={project.url}
	target="_blank"
	rel="noopener noreferrer"
	class="group -mx-3 flex items-center gap-3 rounded-md px-3 py-2.5 transition-colors hover:bg-background-2"
>
	<span class="flex size-5 shrink-0 items-center justify-center">
		<BrandIcon name={project.icon} width={18} height={18} class="text-foreground" />
	</span>

	<span class="w-36 shrink-0 truncate text-sm font-medium text-foreground sm:w-40">
		{project.name}
	</span>

	<span class="hidden min-w-0 flex-1 truncate text-sm text-foreground-3 md:block">
		{project.description}
	</span>

	<!-- Repo label or external arrow -->
	<span class="flex shrink-0 items-center justify-end gap-1 font-mono text-xs tabular-nums text-foreground-3 transition-colors group-hover:text-foreground-2">
		{repoLabel ? (
			<span class="hidden sm:block">{repoLabel}</span>
		) : (
			<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
				<polyline points="15 3 21 3 21 9"/>
				<line x1="10" y1="14" x2="21" y2="3"/>
			</svg>
		)}
	</span>
</a>

---
interface NavItem {
	href: string;
	label: string;
}

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const navItems: NavItem[] = [
	{ href: `${base}/`, label: "home" },
	{ href: `${base}/about`, label: "about" },
	{ href: `${base}/projects`, label: "projects" },
	{ href: `${base}/achievements`, label: "achievements" },
	{ href: `${base}/bookshelf`, label: "bookshelf" },
	{ href: `${base}/contact`, label: "contact" },
];

const { pathname } = Astro.url;

function isActive(href: string): boolean {
	if (href === `${base}/` || href === `${base}`) {
		return pathname === `${base}/` || pathname === `${base}`;
	}
	return pathname.startsWith(href);
}
---

<nav class="sticky top-24 w-64 hidden lg:block">
    <ul class="space-y-1.5 text-sm lowercase">
        {
            navItems.map((item) => (
                <li>
                    <a
                        class:list={[
                            "font-serif italic block py-0.5 transition-colors duration-200",
                            isActive(item.href)
                                ? "text-foreground font-semibold"
                                : "text-foreground-2 hover:text-foreground",
                        ]}
                        href={item.href}
                    >
                        {item.label}
                    </a>
                </li>
            ))
        }
    </ul>
</nav>

<!-- Mobile Navigation -->
<nav class="block lg:hidden mb-8 pb-2 border-b border-ui/20 overflow-x-auto scrollbar-none">
    <ul class="flex gap-2 justify-end text-[13px] lowercase w-max ml-auto">
        {
            navItems.map((item) => (
                <li>
                    <a
                        class:list={[
                            "font-serif block px-2 py-1 transition-colors duration-200",
                            isActive(item.href)
                                ? "text-foreground font-semibold"
                                : "text-foreground-2 hover:text-foreground",
                        ]}
                        href={item.href}
                    >
                        {item.label}
                    </a>
                </li>
            ))
        }
    </ul>
</nav>

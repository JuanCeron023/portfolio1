---
import BrandIcon from "../brand/BrandIcon.astro";
import Flag from "../brand/Flag.astro";

interface Props {
	name: string;
	title: string;
}

const { name, title } = Astro.props;

const linkClass =
	"text-foreground font-medium underline decoration-ui hover:bg-foreground hover:text-background transition-colors";

// Roles cycled by the rotating subtitle.
const roles = ["Senior SWE", "Go Engineer", "Systems Builder", "SaaS Founder"];
const avatarSrc = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/images/avatar.png`;
---

<header class="hero-reveal flex gap-2 items-center justify-start w-full" style="--reveal-delay: 0ms">
    <span class="relative flex size-7 shrink-0 mr-1">
        <img
            src={avatarSrc}
            alt="Juan Manuel Cerón"
            class="size-7 rounded-full object-cover"
        />
    </span>
    <h1 class="text-xl tracking-tight font-medium text-foreground">
        {name}
    </h1>
    <span class="text-sm text-foreground-2"> ~ </span>
    <span
        id="hero-role"
        class="text-base font-serif text-foreground-2 font-light whitespace-nowrap"
        data-roles={JSON.stringify(roles)}
    >
        {title}
    </span>
    <Flag country="co" />
</header>

<section class="flex flex-col gap-2">
    <p class="hero-reveal text-base text-foreground-2 !m-0" style="--reveal-delay: 90ms">
        I'm a <i>Senior Software Engineer</i> specializing in <strong>distributed systems</strong> and <strong>cloud-native architectures</strong>.
        Currently building high-throughput backend services at <a
            href="https://www.globant.com"
            target="_blank"
            class={linkClass}>Globant</a
        > for <a
            href="https://www.disney.com"
            target="_blank"
            class={linkClass}>Disney</a
        >.
    </p>

    <p class="hero-reveal text-base text-foreground-2 !m-0" style="--reveal-delay: 180ms">
        Previously <i>Senior Backend Engineer</i> at <a
            href="https://www.mercadolibre.com"
            target="_blank"
            class={linkClass}>Mercado Libre</a
        >, building event-driven Go systems at scale. Founder of <BrandIcon
            name="terminal"
            width={14}
            height={14}
            class="inline-block mb-0.5 mr-0.5 align-text-bottom"
        /><a
            href="https://contratosoptima.com"
            target="_blank"
            class={linkClass}>Optima</a
        > — a B2B SaaS platform I designed and built end-to-end.
    </p>

    <p class="hero-reveal text-base text-foreground-2 !m-0" style="--reveal-delay: 270ms">
        Find my work on <BrandIcon
            name="github"
            width={14}
            height={14}
            class="inline-block mb-0.5 mr-0.5 align-text-bottom"
        /><a
            href="https://github.com/JuanCeron023"
            target="_blank"
            class={linkClass}>GitHub</a
        > or connect on <a
            href="https://linkedin.com/in/juanmanuelceronaraujo"
            target="_blank"
            class={linkClass}>LinkedIn</a
        >.
    </p>

    <div class="hero-reveal flex flex-wrap gap-2 mt-3" style="--reveal-delay: 360ms">
        <a
            href="https://contratosoptima.com"
            target="_blank"
            class="group inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md border border-ui/50 hover:border-ui transition-all duration-200"
        >
            <BrandIcon name="terminal" width={14} height={14} />
            <span
                class="text-xs text-foreground-2 group-hover:text-foreground transition-colors"
                >Optima – B2B SaaS Founder</span
            >
        </a>
        <a
            href="https://www.credly.com/users/juan-manuel-ceron-araujo.4f4e3e87"
            target="_blank"
            class="group inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md border border-ui/50 hover:border-ui transition-all duration-200"
        >
            <BrandIcon name="code" width={14} height={14} class="text-foreground" />
            <span
                class="text-xs text-foreground-2 group-hover:text-foreground transition-colors"
                >AWS & Google AI Certified</span
            >
        </a>
    </div>
</section>

<style>
    /* Staggered entrance — reuses the site's blur-scale language */
    @keyframes hero-reveal-in {
        from {
            opacity: 0;
            filter: blur(6px);
            transform: translateY(6px);
        }
        to {
            opacity: 1;
            filter: blur(0);
            transform: translateY(0);
        }
    }

    .hero-reveal {
        opacity: 0;
        animation: hero-reveal-in 0.55s cubic-bezier(0.22, 1, 0.36, 1) forwards;
        animation-delay: var(--reveal-delay, 0ms);
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-reveal {
            opacity: 1;
            animation: none;
        }
    }

    /* Rotating role: blur-swap each word */
    @keyframes role-swap-in {
        from {
            opacity: 0;
            filter: blur(4px);
        }
        to {
            opacity: 1;
            filter: blur(0);
        }
    }

    #hero-role.is-swapping {
        animation: role-swap-in 0.4s ease-out;
    }
</style>

<script>
    function startRoleRotation() {
        const el = document.getElementById("hero-role");
        if (!el) return;

        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (reduce) return;

        let roles: string[] = [];
        try {
            roles = JSON.parse(el.dataset.roles ?? "[]");
        } catch {
            return;
        }
        if (roles.length < 2) return;

        let i = 0;
        const tick = () => {
            i = (i + 1) % roles.length;
            el.classList.remove("is-swapping");
            // reflow so the animation restarts
            void el.offsetWidth;
            el.textContent = roles[i];
            el.classList.add("is-swapping");
        };

        // Start after the entrance settles
        window.setInterval(tick, 2600);
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", startRoleRotation);
    } else {
        startRoleRotation();
    }
    document.addEventListener("astro:after-swap", startRoleRotation);
</script>

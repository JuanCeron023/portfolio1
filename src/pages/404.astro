---
import Footer from "@/components/layout/Footer.astro";
import PageLayout from "@/components/layout/PageLayout.astro";
import Layout from "@/layouts/Layout.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout
	title="Page not found – Juan Manuel Cerón"
	description="The requested page could not be found. Use the links below to navigate back."
>
	<PageLayout class="flex flex-col gap-10">
		<header class="space-y-4">
			<p class="font-mono text-xs text-foreground-3">404</p>
			<h1 class="text-2xl font-semibold tracking-tight">Page not found</h1>
			<p class="max-w-2xl text-sm leading-relaxed text-foreground-2">
				The requested URL could not be found. Use the navigation links below to return to the site.
			</p>
		</header>
		<nav aria-label="Recovery links">
			<ul class="space-y-3 text-sm">
				<li><a class="underline hover:text-foreground text-foreground-2" href={`${base}/`}>Home</a></li>
				<li><a class="underline hover:text-foreground text-foreground-2" href={`${base}/about`}>About</a></li>
				<li><a class="underline hover:text-foreground text-foreground-2" href={`${base}/projects`}>Projects</a></li>
				<li><a class="underline hover:text-foreground text-foreground-2" href={`${base}/contact`}>Contact</a></li>
			</ul>
		</nav>
		<Footer />
	</PageLayout>
</Layout>

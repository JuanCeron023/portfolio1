---
export const prerender = true;
const target = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/contact`;
---
<!doctype html>
<html>
<head>
	<meta http-equiv="refresh" content={`0;url=${target}`} />
	<script define:vars={{ target }}>window.location.replace(target)</script>
</head>
<body></body>
</html>

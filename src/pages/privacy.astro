---
import Footer from "@/components/layout/Footer.astro";
import PageLayout from "@/components/layout/PageLayout.astro";
import Layout from "@/layouts/Layout.astro";
import { siteConfig } from "@/config/site";
---

<Layout
	title={`Privacy – ${siteConfig.name}`}
	description={`Privacy information for visitors of ${siteConfig.name}'s portfolio.`}
>
	<PageLayout class="flex flex-col gap-10">
		<header class="space-y-4">
			<h1 class="text-2xl font-semibold tracking-tight">Privacy Notice</h1>
			<p class="max-w-2xl text-sm leading-relaxed text-foreground-2">
				This is a personal professional portfolio website. Most pages can be viewed freely without creating an account or providing personal details.
			</p>
		</header>
		<div class="max-w-2xl space-y-8 text-sm leading-relaxed text-foreground-2">
			<section class="space-y-3">
				<h2 class="font-medium text-foreground">Analytics and Server Logs</h2>
				<p>Standard server and edge logs may include request metadata such as IP address, user agent, URL, timestamp, and error details strictly for security and reliability diagnostics.</p>
			</section>
			<section class="space-y-3">
				<h2 class="font-medium text-foreground">External Services & Contact</h2>
				<p>External links (such as GitHub, LinkedIn, Credly, and Optima) are governed by their respective platforms' privacy policies. If you contact me via email at <a href={`mailto:${siteConfig.email}`} class="underline">{siteConfig.email}</a>, your email address is only used to respond to your inquiry.</p>
			</section>
		</div>
		<Footer />
	</PageLayout>
</Layout>

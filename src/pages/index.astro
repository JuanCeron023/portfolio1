---
import AchievementRow from "@/components/home/AchievementRow.astro";
import FeaturedProjectRow from "@/components/home/FeaturedProjectRow.astro";
import Footer from "@/components/layout/Footer.astro";
import HeroSection from "@/components/layout/HeroSection.astro";
import PageLayout from "@/components/layout/PageLayout.astro";
import SectionHeader from "@/components/layout/SectionHeader.astro";
import SectionLink from "@/components/ui/SectionLink.astro";
import { ogUrl, siteConfig } from "@/config/site";
import { achievements } from "@/data/achievements";
import { featuredProjects } from "@/data/projects";
import Layout from "@/layouts/Layout.astro";

const ogImage = ogUrl({
	title: "Juan Manuel Cerón",
	description:
		"Senior Software Engineer specialized in distributed systems, cloud-native architectures, and high-scale backend platforms.",
});

const achievementsByYear = achievements.reduce(
	(acc, item) => {
		if (!acc[item.year]) {
			acc[item.year] = [];
		}
		acc[item.year].push(item);
		return acc;
	},
	{} as Record<string, typeof achievements>,
);
const achievementYears = Object.keys(achievementsByYear).sort(
	(a, b) => Number(b) - Number(a),
);

// We won't fetch stars for Juan's portfolio right now to keep it simple, but we can map the projects directly
const maxStars = Math.max(...featuredProjects.map((p) => p.stars ?? 0));
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const rankedProjects = featuredProjects.map(p => ({ ...p, stars: 0 }));
---

<Layout
	title={`${siteConfig.name} - ${siteConfig.hero.role}`}
	description={siteConfig.description}
	image={ogImage}
>
	<PageLayout>
		<HeroSection name={siteConfig.name} title={siteConfig.hero.title} />

		<section class="w-full" aria-labelledby="what-i-build">
			<SectionHeader id="what-i-build">What I do</SectionHeader>
			<p class="max-w-2xl text-sm leading-relaxed text-foreground-2">
				I focus on solving distributed systems problems for high throughput architectures: designing fault-tolerant systems, improving observability, and optimizing cloud infrastructure for performance and reliability.
			</p>
		</section>

		<section class="w-full">
			<SectionLink title="Featured Experience" href={`${base}/projects`} />
			<div class="space-y-0">
				{rankedProjects.map((project) => <FeaturedProjectRow project={project} maxStars={maxStars} />)}
			</div>
		</section>

		<section class="w-full">
			<SectionLink title="Certifications & Awards" href={`${base}/achievements`} />
			<div class="space-y-0">
				{achievementYears.map((year) => (
					<div class="mt-6 first:mt-2">
						<div class="mb-1 flex items-center gap-3">
							<span class="font-mono text-xs tabular-nums tracking-wider text-foreground-3">{year}</span>
							<span class="h-px flex-1 bg-ui"></span>
						</div>
						{achievementsByYear[year].map((item) => <AchievementRow item={item} />)}
					</div>
				))}
			</div>
		</section>

		<Footer />
	</PageLayout>
</Layout>

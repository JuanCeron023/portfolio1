---
import Footer from "@/components/layout/Footer.astro";
import PageLayout from "@/components/layout/PageLayout.astro";
import Layout from "@/layouts/Layout.astro";

const links = [
	{
		title: "LinkedIn",
		href: "https://linkedin.com/in/juanmanuelceronaraujo",
		detail: "Professional profile, work history, and endorsements.",
	},
	{
		title: "GitHub",
		href: "https://github.com/JuanCeron023",
		detail: "Source code, repositories, and open contributions.",
	},
	{
		title: "Credly – Certifications",
		href: "https://www.credly.com/users/juan-manuel-ceron-araujo.4f4e3e87",
		detail: "Verified badges: AWS Solutions Architect, Google AI Professional, MongoDB SI Architect, Azure Fundamentals.",
	},
	{
		title: "Optima – B2B SaaS",
		href: "https://contratosoptima.com",
		detail: "SECOP II procurement alert platform for Colombian businesses. Designed and built end-to-end.",
	},
	{
		title: "Email",
		href: "mailto:juanceron256@gmail.com",
		detail: "juanceron256@gmail.com — best for work inquiries, collaborations, or consulting.",
	},
];
---

<Layout
	title="Contact & Links – Juan Manuel Cerón"
	description="Contact and professional links for Juan Manuel Cerón, Senior Software Engineer specializing in Go, AWS, and distributed systems."
>
	<PageLayout class="flex flex-col gap-12">
		<header class="space-y-4">
			<h1 class="text-2xl font-semibold tracking-tight">Contact & Links</h1>
			<p class="max-w-2xl text-sm leading-relaxed text-foreground-2">
				Senior Software Engineer specializing in distributed systems, event-driven
				architectures, and cloud-native backend development. Available for senior/staff
				engineering roles, consulting, and technical collaborations.
			</p>
		</header>

		<section aria-labelledby="links-heading" class="space-y-5">
			<h2 id="links-heading" class="text-sm font-medium uppercase tracking-wider text-foreground-2">Where to find me</h2>
			<ul class="divide-y divide-ui/50">
				{links.map((link) => (
					<li class="py-4 first:pt-0">
						<a href={link.href} target="_blank" rel="noopener noreferrer" class="font-medium text-foreground underline decoration-ui underline-offset-4 hover:decoration-foreground transition-all">{link.title}</a>
						<p class="mt-1 text-sm leading-relaxed text-foreground-2">{link.detail}</p>
					</li>
				))}
			</ul>
		</section>

		<section aria-labelledby="stack-heading" class="space-y-3">
			<h2 id="stack-heading" class="text-sm font-medium uppercase tracking-wider text-foreground-2">Core Stack</h2>
			<p class="max-w-2xl text-sm leading-relaxed text-foreground-2">
				Go · AWS (Kinesis, SQS, EventBridge, Lambda, ECS) · MongoDB · Docker · Datadog · Grafana · PostgreSQL · Redis · Java (Spring Boot)
			</p>
		</section>

		<Footer />
	</PageLayout>
</Layout>

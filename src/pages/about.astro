---
import BrandIcon from "@/components/brand/BrandIcon.astro";
import type { BrandName } from "@/components/brand/registry";
import Footer from "@/components/layout/Footer.astro";
import PageLayout from "@/components/layout/PageLayout.astro";
import SectionHeader from "@/components/layout/SectionHeader.astro";
import Layout from "@/layouts/Layout.astro";

const ogTitle = "About";
const ogDescription =
	"Senior Software Engineer from Pasto, Colombia. Specializing in distributed systems, Go, AWS, and cloud-native architectures. Backend engineer at Disney via Globant, ex Mercado Libre, and founder of Optima.";
const ogImage = "/images/avatar.png";

const linkClass =
	"text-foreground underline decoration-ui hover:bg-foreground hover:text-background transition-colors";

interface Milestone {
	year: string;
	title: string;
	detail: string;
	icon?: BrandName;
	url?: string;
}

// Newest first — the timeline reads top-down from now into the past.
const milestones: Milestone[] = [
	{
		year: "2026",
		title: "Founded Optima – B2B SaaS",
		detail:
			"Designed and built end-to-end a SaaS platform that automates SECOP II public procurement monitoring in Colombia, delivering bi-hourly email alerts to paying business clients.",
		icon: "terminal",
		url: "https://contratosoptima.com",
	},
	{
		year: "2026",
		title: "AWS Solutions Architect – Associate",
		detail: "Certified by Amazon Web Services. Also holds Google AI Professional, MongoDB SI Architect, and Azure Fundamentals certifications.",
		icon: "code",
		url: "https://www.credly.com/users/juan-manuel-ceron-araujo.4f4e3e87",
	},
	{
		year: "2024 – now",
		title: "Senior Backend Engineer at Globant (Disney)",
		detail:
			"Redesigning Go microservices processing 30K+ daily state updates. Building event-driven pipelines with Kinesis, SQS, EventBridge, and MongoDB. Driving a 2× throughput improvement while reducing infrastructure cost.",
		icon: "code",
		url: "https://www.globant.com",
	},
	{
		year: "2023",
		title: "Sr. Backend Engineer at Mercado Libre",
		detail:
			"Built and operated high-throughput event-driven Go backends processing tens of thousands of events daily using Pub/Sub, ensuring fault tolerance and horizontal scalability.",
		icon: "code",
		url: "https://www.mercadolibre.com",
	},
	{
		year: "2023",
		title: "Backend Engineer at Pragma",
		detail:
			"Developed scalable APIs and microservices. Contributed to cloud cost optimization and led knowledge-transfer sessions with junior engineers.",
		icon: "code",
	},
	{
		year: "2021 – 2022",
		title: "Backend Developer at Soporte Lógico",
		detail:
			"Built RESTful services in Go and integrated third-party APIs. Introduced observability tooling (Datadog) and contributed to DevOps workflows.",
		icon: "code",
	},
	{
		year: "2017 – 2022",
		title: "Systems Engineering – Mariana University",
		detail:
			"Full-tuition scholarship (highest GPA in cohort). Published two apps on Google Play during undergraduate studies.",
		url: "https://www.umariana.edu.co",
	},
];

// Group consecutive milestones under one year header
const milestonesByYear = milestones.reduce(
	(acc, m) => {
		const last = acc[acc.length - 1];
		if (last && last.year === m.year) {
			last.items.push(m);
		} else {
			acc.push({ year: m.year, items: [m] });
		}
		return acc;
	},
	[] as { year: string; items: Milestone[] }[],
);
---

<Layout
	title="About Juan Manuel Cerón – Senior Software Engineer"
	description={ogDescription}
	image={ogImage}
>
	<PageLayout class="flex flex-col gap-16">
		<SectionHeader title="About" />

		<!-- Intro -->
		<p class="max-w-2xl text-base leading-relaxed text-foreground-2">
			I'm a Senior Software Engineer from Pasto, Colombia. I specialize in
			distributed systems, event-driven architectures, and cloud-native backend
			development. I build things that scale, stay reliable under pressure, and
			ship on time.
		</p>

		<!-- Now -->
		<section class="w-full">
			<div class="mb-4 flex items-center gap-2">
				<span class="relative flex size-2">
					<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-500 opacity-75 motion-reduce:hidden"></span>
					<span class="relative inline-flex size-2 rounded-full bg-green-500"></span>
				</span>
				<SectionHeader title="Now" className="mb-0" />
			</div>
			<ul class="flex flex-col gap-2">
				<li class="flex items-baseline gap-3 text-base text-foreground-2">
					<span class="select-none text-foreground-3" aria-hidden>&rarr;</span>
					<span>
						Senior Backend Engineer at <a href="https://www.globant.com" target="_blank" class={linkClass}>Globant</a> for <a href="https://www.disney.com" target="_blank" class={linkClass}>Disney</a> — building Go microservices and event-driven pipelines at scale
					</span>
				</li>
				<li class="flex items-baseline gap-3 text-base text-foreground-2">
					<span class="select-none text-foreground-3" aria-hidden>&rarr;</span>
					<span>
						Founder of <a href="https://contratosoptima.com" target="_blank" class={linkClass}>Optima</a> — a B2B SaaS platform I designed, built, and maintain end-to-end
					</span>
				</li>
				<li class="flex items-baseline gap-3 text-base text-foreground-2">
					<span class="select-none text-foreground-3" aria-hidden>&rarr;</span>
					<span>
						AWS Certified Solutions Architect · Google AI Professional · MongoDB SI Architect
					</span>
				</li>
			</ul>
		</section>

		<!-- Timeline -->
		<section class="w-full">
			<SectionHeader title="Timeline" className="mb-5" />
			<div class="flex flex-col">
				{milestonesByYear.map((group, gi) => (
					<div class="relative flex gap-5">
						<!-- Year label, once per group -->
						<div class="w-28 shrink-0 pt-0.5 text-right">
							<span class="whitespace-nowrap font-mono text-xs tabular-nums tracking-wider text-foreground-3">{group.year}</span>
						</div>
						<!-- Rail -->
						<div class="relative flex w-2 shrink-0 justify-center">
							<span
								class:list={[
									"absolute w-px bg-ui",
									gi === 0 ? "top-1.5" : "top-0",
									gi === milestonesByYear.length - 1 ? "h-[calc(100%-1.5rem)]" : "h-full",
								]}
							></span>
						</div>
						<!-- Milestones in this year -->
						<ol class="min-w-0 flex-1">
							{group.items.map((m, mi) => (
								<li class="group relative flex gap-3 pb-7" class:list={[gi === milestonesByYear.length - 1 && mi === group.items.length - 1 && "!pb-0"]}>
									<span class="z-10 mt-1.5 -ml-[1.6rem] size-2 shrink-0 rounded-full bg-foreground-3 ring-4 ring-background transition-colors group-hover:bg-foreground"></span>
									<div class="min-w-0 flex-1">
										<div class="flex items-center gap-1.5">
											{m.icon && <BrandIcon name={m.icon} width={14} height={14} class="shrink-0 align-text-bottom text-foreground" />}
											{m.url ? (
												<a href={m.url} target="_blank" class="text-sm font-medium text-foreground underline decoration-ui underline-offset-2 transition-colors hover:decoration-foreground">{m.title}</a>
											) : (
												<span class="text-sm font-medium text-foreground">{m.title}</span>
											)}
										</div>
										<p class="mt-1 text-sm leading-relaxed text-foreground-3">{m.detail}</p>
									</div>
								</li>
							))}
						</ol>
					</div>
				))}
			</div>
		</section>

		<!-- Stack -->
		<section class="w-full">
			<SectionHeader title="Tech Stack" className="mb-3" />
			<p class="max-w-2xl text-sm leading-relaxed text-foreground-2">
				Primary language: <strong>Go</strong>. Cloud: <strong>AWS</strong> (Kinesis, SQS, EventBridge, Lambda, ECS). 
				Databases: <strong>MongoDB</strong>, PostgreSQL, Redis. Observability: <strong>Datadog</strong>, Grafana. 
				Container orchestration: Docker, Kubernetes. Secondary: Java (Spring Boot), Dart/Flutter, TypeScript.
			</p>
		</section>

		<!-- Contact -->
		<section class="w-full">
			<SectionHeader title="Reach me" className="mb-3" />
			<p class="text-sm leading-relaxed text-foreground-2">
				<a href="https://linkedin.com/in/juanmanuelceronaraujo" target="_blank" class={linkClass}>LinkedIn</a> &middot;
				<a href="https://github.com/JuanCeron023" target="_blank" class={linkClass}>GitHub</a> &middot;
				<a href="mailto:juanceron256@gmail.com" class={linkClass}>juanceron256@gmail.com</a>
			</p>
		</section>

		<Footer />
	</PageLayout>
</Layout>
